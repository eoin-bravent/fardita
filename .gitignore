# ============ secrets (never commit) ============
.env
**/.env
*service-account*.json
*-sa.json
service_account*.json
gcp-key*.json

# ============ big regenerable inputs ============
# archives: re-downloadable via the app (orchestrator step 1 / dashboard "Run")
archive/
archive_far/
archive_afars/
archive_rfo/
# nightly-managed clones of the GSA GitHub repos
repos/

# ============ stores (THE DATA -- decide your policy) ============
# Default: keep stores out of the code repo (FAR_store.json will exceed GitHub's
# 100 MB limit after the full backfill). To version them instead, remove these
# lines and set up Git LFS:  git lfs track "stores/**/*.json"
stores/
stores_*/

# ============ pipeline: reference implementation, RETIRED from the repo (kept locally only) ============
pipeline/

# ============ docs: commit only .json (e.g. BASELINE.json for `verify`); markdown/html/pdf stay local ============
docs/*
!docs/*.json

# ============ derived caches (regenerated by the tools) ============
# era surveys + structure hints (archive_adapter.py survey / derive-hints)
pipeline/cache/
# run scratch: chunks, ledgers, review pages, LLM cache
pipeline/out/

# ============ python ============
__pycache__/
*.pyc
.venv/
**/.venv/

# ============ OS cruft ============
.DS_Store
Thumbs.db

# personal presentation/demo script (local only)
pipeline/demo_script.md

# ============ local data snapshots (not part of the published app) ============
# working FAR DITA snapshot (the canon source is the GSA GitHub repo / repos/)
dita/
# generated sample outputs
test_data/
canon_git/
